# ==============================================================================
# InfraBench Environment Configuration
# ==============================================================================

# Application Settings
APP_NAME=InfraBench
APP_ENV=development
APP_HOST=0.0.0.0
APP_PORT=8000
LOG_LEVEL=INFO

# PostgreSQL Configuration
POSTGRES_HOST=db
POSTGRES_PORT=5432
POSTGRES_DB=infrabench
POSTGRES_USER=infrabench_user
POSTGRES_PASSWORD=infrabench_secure_pass

# Redis Configuration
REDIS_HOST=cache
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_CACHE_TTL_SECONDS=60
